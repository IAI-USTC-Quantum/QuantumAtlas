# Go executables and build/test output. Git stores source, not local binaries.
/qatlasd
/downloaderproxy
/downloaderworker
/build/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.coverprofile
coverage.*
profile.cov

# Optional local Go toolchain caches/workspace (not a second version source).
.gocache/
.gomodcache/
go.work
go.work.sum

# Web dependencies and generated UI. routeTree.gen.ts is generated SOURCE and
# remains tracked, as do internal/apidocs Go/JSON/YAML sources.
node_modules/
/web/dist/
/web/dist-ssr/
/web/public/doc/
/web/public/devdoc/
/web/.tanstack/

# Documentation output; Python is used only for docs and CI helpers.
/site/
/docs-dist/
docs/_build/
docsite/_build/
docs/server/openapi.json
__pycache__/
*.py[codz]
.venv/
.venv-*/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.pixi/
# Do not accidentally publish legacy packaging leftovers from an old checkout.
*.egg-info/
.pypirc

# Secrets and local configuration. Only explicit examples are versioned.
.env
.env.*
!.env.*.example
!.env.example
.envrc
*.local

# Runtime state belongs outside source checkouts; protect accidental local runs.
/data/
/output/
/pb_data/
/raw/
*.log

# Local/editor/session scratch.
/tmp/
.cache/
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.abstra/
CLAUDE.md
.codex/
.cursorignore
.cursorindexingignore
session-recap-*.html
scripts/*cifs*.sh
scripts/setup_quantum_team_*.sh
scripts/test_quantum_team_*.sh
