# Build context exclusions — keep the image build pure (just web/ + Go
# sources) and skip everything that would either bloat the build
# context, leak local data, or break the deterministic build.

# Git history / hooks — never useful inside the image and bigger than
# you'd think.
.git
.github

# Editor / IDE state.
.idea
.vscode
.cursor
*.swp
*.swo

# Dependency / build caches; web/dist is a REQUIRED prebuilt input, not
# rebuilt in Docker. Keep the GoReleaser output and Sphinx intermediates out.
node_modules
web/node_modules
dist
build
web/public/doc
web/public/devdoc
docsite
.pixi
.gocache
.venv
.venv-*

# Runtime data the dev / prod machine has but the image must not capture.
pb_data
raw
data
wiki

# Local secrets / per-machine config. Never bake these into an image.
# qatlasd embeds templates/config.yaml, not a legacy .env template.
.env
.env.*

# Documentation isn't needed at runtime — saves a few MB in the build
# context. (README.md is whitelisted because some tooling looks for it.)
docs
*.md
!README.md

# Python tooling cruft.
.pytest_cache
__pycache__
*.egg-info
*.pyc
.mypy_cache
.ruff_cache

# Test reports / coverage.
coverage.out
*.coverprofile

# OS junk.
.DS_Store
Thumbs.db

# Preserve every file of the validated UI tree (including Sphinx dotfiles).
!web/dist/
!web/dist/**
