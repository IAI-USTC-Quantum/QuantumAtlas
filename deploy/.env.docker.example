# deploy/.env — docker-compose variable interpolation ONLY.
#
# qatlasd itself reads NO environment variables. Its configuration lives
# in a YAML file on the host, bind-mounted into the container read-only
# by docker-compose.yml:
#
#   ${HOME}/.qatlas/config.yaml → /home/nonroot/.qatlas/config.yaml (ro)
#
# Create / edit it with:
#   qatlasd config init
#   $EDITOR ~/.qatlas/config.yaml      # postgres.dsn, s3.*, auth.*, system_pat.*, ...
# (see config.example.yaml at the repo root for the full key reference)
#
# Any QATLAS_* / MINERU_* / GITHUB_CLIENT_* variable exported here would
# make qatlasd REFUSE to start (env-based configuration was removed).

# Image tag for ghcr.io/iai-ustc-quantum/qatlasd (default: latest).
QATLAS_VERSION=latest

# Image tag for ghcr.io/iai-ustc-quantum/qatlas-search — only used with
# `docker compose --profile search up -d` (default: latest). Pin both to
# explicit release tags (e.g. v0.22.1 / v0.1.0) for reproducible deploys.
QATLAS_SEARCH_VERSION=latest

# Image tag for ghcr.io/iai-ustc-quantum/qatlas-rag — only used with
# `docker compose --profile rag up -d` (default: latest). The service
# needs an NVIDIA GPU; see the qatlas-rag block in docker-compose.yml.
QATLAS_RAG_VERSION=latest

# Image tag for ghcr.io/iai-ustc-quantum/qatlas-match — only used with
# `docker compose --profile match up -d` (default: latest). Pin to an
# explicit release tag (e.g. v0.1.0) for reproducible deploys.
QATLAS_MATCH_VERSION=latest
